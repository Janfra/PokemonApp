@using PokemonApp.Models

<article class="pokemon-display-container">
	<span class="pokemon-id muted-text text-small">#@Pokemon.Id.ToString("D3")</span>
	<div class="pokemon-shiny-toggle-wrapper">
		<Toggle @bind-value=_isShiny KnobContent="✨" IsLowOpacity=true />
	</div>
	<img src="@Sprite" alt="Sprite of @Pokemon.Name" class="sprite-display" />
	<p class="pokemon-name">@Pokemon.Name</p>

	<div class="type-badge-container">
		@foreach (var type in Pokemon.Types)
		{
			<div class="type-badge type-@type.Type.Name">
				<p>@type.Type.Name</p>
			</div>
		}
	</div>
</article>

@code {
	[EditorRequired]
	[Parameter]
	public Pokemon Pokemon { get; set; }

	private bool _isShiny;

	public string Sprite
	{
		get
		{
			return _isShiny ? Pokemon.Sprites.FrontShiny : Pokemon.Sprites.FrontDefault;
		}
	}
}

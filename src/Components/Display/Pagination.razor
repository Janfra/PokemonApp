@typeparam TItem

<div class="pagination-controls">
    <button @onclick="FirstPage" disabled="@_isPreviousDisabled">@(FirstPageContent is not null ? FirstPageContent : _defaultFirst)</button>
    <button @onclick="PreviousPage" disabled="@_isPreviousDisabled">@(PreviousPageContent is not null ? PreviousPageContent : _defaultPrevious)</button>

	@foreach (var pageNumber in IsSliding ? GetSlidingPageNumberRange() : GetStaticPageNumberRange())
	{
		<button @onclick="() => GoToPage(pageNumber)" class="@GetPageNumberClass(pageNumber)">
			@pageNumber
		</button>
	}

    <button @onclick="NextPage" disabled="@_isNextDisabled">@(NextPageContent is not null ? NextPageContent : _defaultNext)</button>
	<button @onclick="LastPage" disabled="@_isNextDisabled">@(LastPageContent is not null ? LastPageContent : _defaultLast)</button>
</div>

@code {
    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 10;

    [Parameter]
    public int MaxPaginationLength { get; set; } = 10;

    [Parameter]
    public bool IsSliding { get; set; } = false;

    [Parameter]
    public int? TotalPagesOverride { get; set; } = null;

    [Parameter]
    public RenderFragment? PreviousPageContent { get; set; }

    [Parameter]
    public RenderFragment? NextPageContent { get; set; }

    [Parameter]
    public RenderFragment? FirstPageContent { get; set; }

    [Parameter]
    public RenderFragment? LastPageContent { get; set; }

    [Parameter]
    public int Page { get; set; } = 1;

    [Parameter]
    public EventCallback<int> OnPageChanged { get; set; }

    /// <summary>
    /// On page change, it is invoked with the items included in the page based on items inside <c>Items</c>.
    /// </summary>
    [Parameter]
    public EventCallback<IEnumerable<TItem>> OnPaginationItemsChanged { get; set; }

    public int TotalPages
    {
        get
        {
            if (TotalPagesOverride is not null || Items is null)
            {
                return TotalPagesOverride ?? 0;
            }
            else
            {
                return (int)Math.Ceiling(Items.Count() / (double)PageSize);
            }
        }
    }

    private const string _defaultPrevious = "Previous";
    private const string _defaultNext = "Next";
    private const string _defaultFirst = "First";
    private const string _defaultLast = "Last";

    private bool _isPreviousDisabled => Page == 1;
    private bool _isNextDisabled => Page == TotalPages;

    protected override void OnParametersSet()
    {
        Page = Math.Clamp(Page, 1, TotalPages);
    }

    private IEnumerable<TItem> GetPaginatedItems()
    {
        return Items is not null ? Items.Skip((Page - 1) * PageSize).Take(PageSize) : Array.Empty<TItem>();
    }

    private IEnumerable<int> GetStaticPageNumberRange()
    {
        // Cache total pages since it can be calculated in property each time
        var cacheTotalPages = TotalPages;
        if (cacheTotalPages <= 0)
        {
            return Array.Empty<int>();
        }

        int blockIndex = (Page - 1) / MaxPaginationLength;
        int rangeStart = (blockIndex * MaxPaginationLength) + 1;
        int rangeEnd = Math.Min(rangeStart + MaxPaginationLength - 1, cacheTotalPages);
        int rangeSize = rangeEnd - rangeStart + 1;
        return Enumerable.Range(rangeStart, rangeSize);
    }

    private IEnumerable<int> GetSlidingPageNumberRange()
    {
        // Cache total pages since it can be calculated in property each time
        var cacheTotalPages = TotalPages;
        if (cacheTotalPages <= 0)
        {
            return Array.Empty<int>();
        }

        int currentWindowLength = Math.Min(MaxPaginationLength, TotalPages);
        int adjustedWindowLength = currentWindowLength - 1;
        int rangeStart = Page - adjustedWindowLength / 2;

        if (rangeStart < 1)
        {
            rangeStart = 1;
        }

        if (rangeStart + adjustedWindowLength > cacheTotalPages)
        {
            rangeStart = cacheTotalPages - currentWindowLength + 1;
        }

        return Enumerable.Range(rangeStart, currentWindowLength);
    }

    private string GetPageNumberClass(int pageNumber)
    {
        return Page == pageNumber ? "active" : "";
    }

    private async Task NextPage()
    {
        if (Page < TotalPages)
        {
            Page++;
            await UpdateValues();
        }
    }

    private async Task PreviousPage()
    {
        if (Page > 1)
        {
            Page--;
            await UpdateValues();
        }
    }

    private async Task GoToPage(int pageNumber)
    {
        if (pageNumber == Page) return;

        Page = Math.Clamp(pageNumber, 1, TotalPages);
        await UpdateValues();
    }

    private async Task FirstPage()
    {
        if (Page > 1)
        {
            Page = 1;
            await UpdateValues();            
        }
    }

    private async Task LastPage()
    {
        if (Page < TotalPages)
        {
            Page = TotalPages;
            await UpdateValues();
        }
    }

    private async Task UpdateValues()
    {
        var valueEvent = OnPageChanged.InvokeAsync(Page);
        if (OnPaginationItemsChanged.HasDelegate)
        {
            var paginationEvent = OnPaginationItemsChanged.InvokeAsync(GetPaginatedItems());        
            await Task.WhenAll(paginationEvent, valueEvent);
        }
        else
        {
            await valueEvent;
        }
    }
}

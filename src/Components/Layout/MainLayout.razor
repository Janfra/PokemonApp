@inherits LayoutComponentBase

<div class="page @_themeClass">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
			<ThemeToggle></ThemeToggle>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code{
    [Inject]
    private IHttpContextAccessor _httpContextAccessor { get; set; } = null!;
    private string _themeClass { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        if (_httpContextAccessor.HttpContext is not null)
        {
            // For now hardcoded key, need to move it to a class holding the value
            if (_httpContextAccessor.HttpContext.Request.Cookies.TryGetValue("theme-preference", out string? themeCookie))
            {
                switch (themeCookie)
                {
                    case "dark":
                        _themeClass = "dark";
                        break;
                    case "light":
                    default:
                        _themeClass = "";
                        break;
                }
            }
        }
    }
}

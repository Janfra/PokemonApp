@page "/phase-two"
@rendermode InteractiveServer

<div class="mb-5 info-card">
	<h3><b>Phase Two - Pagination Display</b></h3>

	<ol>
		<li>Retrieve a list of pokemons from the API.</li>
		<li>Display the resulting Pokemons on the frontend in a pagination.</li>
	</ol>
</div>

<PokemonGrid Page=Page OnPageChanged=HandlePageChange />

@code{
	[SupplyParameterFromQuery(Name = "page")]
	public int Page { get; set; } = 1;

	[Inject]
	private NavigationManager _navigationManager { get; set; } = null!;

	protected override void OnParametersSet()
	{
		Page = Math.Max(1, Page);
	}

	private void HandlePageChange(int pageNumber)
	{
		string nextUrl = _navigationManager.GetUriWithQueryParameter("page", pageNumber);
		_navigationManager.NavigateTo(nextUrl);
	}
}

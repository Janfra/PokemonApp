@page "/phase-two"
@rendermode InteractiveServer

<div class="mb-5 info-card">
	<h3><b>Phase Two - Pagination Display</b></h3>

	<ol>
		<li>Retrieve a list of pokemons from the API.</li>
		<li>Display the resulting Pokemons on the frontend in a pagination.</li>
	</ol>
</div>

<PokemonGrid Page=Page HrefFactory=GetPageURL />

@code{
	private const string _pageParameterQueryName = "page";

	[SupplyParameterFromQuery(Name = _pageParameterQueryName)]
	public int Page { get; set; } = 1;

	[Inject]
	private NavigationManager _navigationManager { get; set; } = null!;

	protected override void OnParametersSet()
	{
		Page = Math.Max(1, Page);
	}

	private string GetPageURL(int pageNumber)
	{
		return _navigationManager.GetUriWithQueryParameter(_pageParameterQueryName, pageNumber);
	}
}

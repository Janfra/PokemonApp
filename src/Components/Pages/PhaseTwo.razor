@page "/phase-two"
@using Microsoft.AspNetCore.Http.HttpResults
@using PokemonApp.Services
@rendermode InteractiveServer
@inject IPokemonService PokemonService;

<div class="mb-5 info-card">
	<h3><b>Phase Two - Pagination Display</b></h3>

	<ol>
		<li>Retrieve a list of pokemons from the API.</li>
		<li>Display the resulting Pokemons on the frontend in a pagination.</li>
	</ol>
</div>

@if (_pokemonList is null)
{
	<p class="text-center"><em>Loading list...</em></p>
}
else
{
	<div class="flex-wrap d-inline-flex">
			@if(_paginatedPokemon is not null)
			{
				@foreach (var pokemon in _paginatedPokemon)
				{
					<div class="m-1">
						<PokemonDisplay Pokemon="@pokemon"/>
					</div>
				}			
			}
	</div>
	
	<Pagination TItem="Pokemon" Items="_pokemonList" OnPaginationItemsChanged="SetPaginatedPokemon">
		<PreviousPageContent>Previous</PreviousPageContent>
		<NextPageContent>Next</NextPageContent>
	</Pagination>
}

@code {
	private List<Pokemon>? _pokemonList;
	private IEnumerable<Pokemon>? _paginatedPokemon;

	protected override async Task OnInitializedAsync()
	{
		var results = await PokemonService.GetPokemonsAsync(20);
		if (results.Result is NotFound)
		{
			// Handle not found
			_pokemonList = new();
		}
		else if (results.Result is Ok<List<Pokemon>> okResult)
		{
			_pokemonList = okResult.Value;
		}
	}

	private void SetPaginatedPokemon(IEnumerable<Pokemon> args)
	{
		_paginatedPokemon = args;
	}
}
